# Copy to .env on the live server and fill every blank. Then run: php artisan abmm:go-live-check
APP_NAME="ABMM Sampark"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sampark.example.org
APP_KEY=                      # php artisan key:generate (once)

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abmm
DB_USERNAME=abmm
DB_PASSWORD=

# Redis for cache, sessions and queue
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.org
MAIL_FROM_NAME="ABMM Sampark"

# Login: Firebase Phone Auth (TEST_OTP must stay EMPTY)
FIREBASE_PROJECT_ID=
TEST_OTP=

# Payments: LIVE keys after Razorpay KYC
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=            # optional: AI search / matching / course drafts
BACKUP_KEEP_DAYS=14
EXAM_QUESTIONS=10
BLOOD_GAP_DAYS=90

# iPhone app (see docs/IOS-PAYMENTS.md)
IOS_DIGITAL_MODE=external
IOS_BUNDLE_ID=
IOS_ALLOW_SANDBOX=false
